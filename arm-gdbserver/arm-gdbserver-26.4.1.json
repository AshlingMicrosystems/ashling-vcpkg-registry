{
  "id": "debuggers/ashling/gdbserver-arm",
  "version": "26.4.1",
  "summary": "Ashling ARM GDB Server for Standard Arm devices",
  "description": "Ashling ARM GDB Server for debugging Arm devices via Ashling Opella-LD.",
  "contacts": {
    "Ashling": {
      "email": "support@ashling.com",
      "role": "publisher"
    }
  },
  "demands": {
    "windows": {
      "install": {
        "unzip": "https://ashling-1.s3.eu-west-1.amazonaws.com/vcpkg-artifacts/arm-gdb-server/gdbserver-arm-win-x86_64-26.4.1.zip",
        "sha256": "03F2995F86A8F70D62A8E33D66449FEC0E25A1F25D68D780B0C0DDC3E5BC0CD7",
        "strip": 1
      },
      "exports": {
        "paths": {
          "PATH": [
            "gdbserver-arm"
          ],
          "DEVICE_DB": [
            "common/devices_db"
          ],
          "GUI_OPXD_LIB": [
            "guiopxdif.dll"
          ]
        },
        "tools": {
          "ash-arm-gdb-server": "gdbserver-arm/ash-arm-gdb-server.exe",
          "opxddiag": "gdbserver-arm/opxddiag.exe"
        }
      }
    },
    "linux": {
      "install": {
        "untar": "https://ashling-1.s3.eu-west-1.amazonaws.com/vcpkg-artifacts/arm-gdb-server/gdbserver-arm-linux-x86_64-26.4.1.tar.gz",
        "sha256": "AB0518D22085367554F2DE5B2E8E4655C811CE160031B23BB54FFC941C0C32B3",
        "strip": 1
      },
      "exports": {
        "paths": {
          "PATH": [
            "gdbserver-arm"
          ],
          "DEVICE_DB": [
            "common/devices_db"
          ],
          "GUI_OPXD_LIB": [
            "libguiopxdif.so"
          ]
        },
        "tools": {
          "ash-arm-gdb-server": "gdbserver-arm/ash-arm-gdb-server",
          "opxddiag": "gdbserver-arm/opxddiag"
        }
      }
    }
  }
}
