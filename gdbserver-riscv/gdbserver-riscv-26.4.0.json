{
  "id": "debuggers/ashling/gdbserver-riscv",
  "version": "26.4.0",
  "summary": "Ashling RISC-V GDB server",
  "description": "GDB server and JTAG probe tooling for debugging RISC-V targets via Ashling probes.",
  "contacts": {
    "Ashling": {
      "email": "support@ashling.com",
      "role": "publisher"
    }
  },
  "demands": {
    "windows": {
      "install": {
        "unzip": "https://ashling-1.s3.eu-west-1.amazonaws.com/vcpkg-artifacts/risc-v-gdb-server/gdbserver-riscv-win-x86_64-26.4.0.zip",
        "sha256": "6E6C1803C7955D6E13628D127B784ADAD61F4A6B2EC813A80F53F3BABEEEF1D8",
        "strip": 1
      },
      "exports": {
        "paths": {
          "PATH": ["gdbserver-riscv"],
          "DEVICE_DB": ["common/devices_db"],
          "GUI_OPXD_LIB": ["guiopxdif.dll"]
        },
        "tools": {
          "ash-riscv-gdb-server": "gdbserver-riscv/ash-riscv-gdb-server.exe",
          "opxddiag" : "gdbserver-riscv/opxddiag.exe"
        }
      }
    }
  }
}
