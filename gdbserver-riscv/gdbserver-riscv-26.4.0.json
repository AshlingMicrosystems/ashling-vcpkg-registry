{
  "id": "debuggers/ashling/gdbserver-riscv",
  "version": "26.4.0",
  "summary": "Ashling RISC-V GDB server",
  "description": "Ashling GDB server for debugging RISC-V devices through Ashling debug probes.",
  "contacts": {
    "Ashling": {
      "email": "support@ashling.com",
      "role": "publisher"
    }
  },
  "demands": {
    "windows": {
      "install": {
        "unzip": "https://ashling-1.s3.eu-west-1.amazonaws.com/vcpkg-artifacts/risc-v-gdb-server/gdbserver-riscv-win-x86_64-26.4.0.zip",
        "sha256": "6C9AD514CF4B4D9E62B7C7BC4BB5D2A891940F5816F6B7E3AE60A02604DFC0F3",
        "strip": 1
      },
      "exports": {
        "paths": {
          "PATH": ["gdbserver-riscv"],
          "DEVICE_DB": ["common/devices_db"],
          "GUI_OPXD_LIB": ["guiopxdif.dll"]
        },
        "tools": {
          "ash-riscv-gdb-server": "gdbserver-riscv/ash-riscv-gdb-server.exe",
          "opxddiag" : "gdbserver-riscv/opxddiag.exe"
        }
      }
    },
    "linux": {
      "install": {
        "untar": "https://ashling-1.s3.eu-west-1.amazonaws.com/vcpkg-artifacts/risc-v-gdb-server/gdbserver-riscv-linux-x86_64-26.4.0.tar.gz",
        "sha256": "DD22163CA0BF236764A4668DEF29AA4217FCD55D1B1FC533D7E7F82C3B2133AA",
        "strip": 1
      },
      "exports": {
        "paths": {
          "PATH": ["gdbserver-riscv"],
          "DEVICE_DB": ["common/devices_db"],
          "GUI_OPXD_LIB": ["libguiopxdif.so"]
        },
        "tools": {
          "ash-riscv-gdb-server": "gdbserver-riscv/ash-riscv-gdb-server",
          "opxddiag" : "gdbserver-riscv/opxddiag"
        }
      }
    }
  }
}
