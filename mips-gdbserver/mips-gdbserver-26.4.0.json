{
  "id": "debuggers/ashling/gdbserver-riscv-mips",
  "version": "26.4.0",
  "summary": "Ashling RISC-V GDB server for MIPS",
  "description": "GDB server and probe tools for debugging MIPS RISC-V cores (I8500, P8700) via Ashling probes, with the King-V and Shogun debug monitors and the dqer trace decoder.",
  "contacts": {
    "Ashling": {
      "email": "support@ashling.com",
      "role": "publisher"
    }
  },
  "demands": {
    "windows": {
      "install": {
        "unzip": "https://ashling-1.s3.eu-west-1.amazonaws.com/vcpkg-artifacts/mips-gdbserver/gdbserver-riscv-mips-win-x86_64-26.4.0.zip",
        "sha256": "C2E2F74EC19E00837DB979811907CB734F62605A94F39995AD6B3C87541ADDCC",
        "strip": 1
      },
      "exports": {
        "paths": {
          "PATH": [
            "gdbserver-riscv"
          ],
          "DEVICE_DB": [
            "common/devices_db"
          ],
          "GUI_OPXD_LIB": [
            "guiopxdif.dll"
          ]
        },
        "tools": {
          "ash-riscv-gdb-server": "gdbserver-riscv/ash-riscv-gdb-server.exe",
          "opxddiag": "gdbserver-riscv/opxddiag.exe"
        }
      }
    },
    "linux": {
      "install": {
        "untar": "https://ashling-1.s3.eu-west-1.amazonaws.com/vcpkg-artifacts/mips-gdbserver/gdbserver-riscv-mips-linux-x86_64-26.4.0.tar.gz",
        "sha256": "BFD88142C6C23B48390B8B7C750A76707CDE40AF9586B57084E07456B45A514A",
        "strip": 1
      },
      "exports": {
        "paths": {
          "PATH": [
            "gdbserver-riscv"
          ],
          "DEVICE_DB": [
            "common/devices_db"
          ],
          "GUI_OPXD_LIB": [
            "libguiopxdif.so"
          ]
        },
        "tools": {
          "ash-riscv-gdb-server": "gdbserver-riscv/ash-riscv-gdb-server",
          "opxddiag": "gdbserver-riscv/opxddiag"
        }
      }
    }
  }
}
