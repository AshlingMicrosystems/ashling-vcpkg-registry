{
  "id": "compilers/ashling/arc-toolchain",
  "version": "15.2.0",
  "summary": "GNU Toolchain for MIPS ARC Classic",
  "description": "GNU toolchain for MIPS ARC Classic processors (ARC 600/700, EM, HS3x, HS4x), arc-2026.03 release: GCC 15.2.0 and GDB, bare metal, Newlib, little endian.",
  "contacts": {
    "Ashling": {
      "email": "support@ashling.com",
      "role": "publisher"
    }
  },
  "demands": {
    "windows": {
      "install": {
        "unzip": "https://ashling-1.s3.eu-west-1.amazonaws.com/vcpkg-artifacts/arc-toolchain/arc-toolchain-win-x86_64-15.2.0.zip",
        "sha256": "9D6CA76D56C3F52865C259AC66658783030AE4CEEFC8D0646F34BADD9E610C8B",
        "strip": 1
      },
      "exports": {
        "paths": {
          "PATH": "bin"
        },
        "tools": {
          "GCC_TOOLCHAIN_15_2_0": "./bin",
          "arc-snps-elf-gcc": "bin/arc-snps-elf-gcc.exe",
          "arc-snps-elf-gdb": "bin/arc-snps-elf-gdb.exe"
        }
      }
    },
    "linux": {
      "install": {
        "untar": "https://ashling-1.s3.eu-west-1.amazonaws.com/vcpkg-artifacts/arc-toolchain/arc-toolchain-linux-x86_64-15.2.0.tar.gz",
        "sha256": "EA8BE93D2FA9A49810221DE59FC899C27B0D5772FE52A160C89D99F40834F222",
        "strip": 1
      },
      "exports": {
        "paths": {
          "PATH": "bin"
        },
        "tools": {
          "GCC_TOOLCHAIN_15_2_0": "./bin",
          "arc-snps-elf-gcc": "bin/arc-snps-elf-gcc",
          "arc-snps-elf-gdb": "bin/arc-snps-elf-gdb"
        }
      }
    }
  }
}
