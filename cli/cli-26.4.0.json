{
  "id": "tools/ashling/cli",
  "version": "26.4.0",
  "summary": "Ashling RiscFree headless CLI",
  "description": "Headless Eclipse-based command-line application (ashling-cli) for the Ashling RiscFree SDK. Ships with its own bundled JRE.",
  "contacts": {
    "Ashling": {
      "email": "support@ashling.com",
      "role": "publisher"
    }
  },
  "demands": {
    "windows": {
      "install": {
        "unzip": "https://ashling-1.s3.eu-west-1.amazonaws.com/vcpkg-artifacts/riscfree-cli/cli-win-x86_64-26.4.0.zip",
        "sha256": "4CCA861EFCC8E0D642555E22AF43B5ABE641F448B40962297C1DFFEB31C1FC58",
        "strip": 1
      },
      "exports": {
        "paths": {
          "PATH": "."
        },
        "tools": {
          "ashling-cli": "ashling-cli.exe"
        }
      }
    },
    "linux": {
      "install": {
        "untar": "https://ashling-1.s3.eu-west-1.amazonaws.com/vcpkg-artifacts/riscfree-cli/cli-linux-x86_64-26.4.0.tar.gz",
        "sha256": "23A06761F625E8009C5B993680DC348DBFE1838639847E1C22F26081EFE7840B",
        "strip": 1
      },
      "exports": {
        "paths": {
          "PATH": "."
        },
        "tools": {
          "ashling-cli": "ashling-cli"
        }
      }
    }
  }
}
