{
  "id": "tools/ashling/cli",
  "version": "26.4.1",
  "summary": "Ashling RiscFree headless CLI",
  "description": "Headless Eclipse-based command-line application (ashling-cli) for the Ashling RiscFree SDK. Ships with its own bundled JRE.",
  "contacts": {
    "Ashling": {
      "email": "support@ashling.com",
      "role": "publisher"
    }
  },
  "demands": {
    "windows": {
      "install": {
        "unzip": "https://ashling-1.s3.eu-west-1.amazonaws.com/vcpkg-artifacts/riscfree-cli/cli-win-x86_64-26.4.1.zip",
        "sha256": "DFE32EF5E29BBB3AA586D6F7E5DBF30C1853862B199C09C31FBEF2C89F7F204A",
        "strip": 1
      },
      "exports": {
        "paths": {
          "PATH": "."
        },
        "tools": {
          "ashling-cli": "ashling-cli.exe"
        }
      }
    },
    "linux": {
      "install": {
        "untar": "https://ashling-1.s3.eu-west-1.amazonaws.com/vcpkg-artifacts/riscfree-cli/cli-linux-x86_64-26.4.1.tar.gz",
        "sha256": "5398A85ECC4C7DCD04E772117440E6A2FD6876789C9C87B497283DFAE9CD3DD7",
        "strip": 1
      },
      "exports": {
        "paths": {
          "PATH": "."
        },
        "tools": {
          "ashling-cli": "ashling-cli"
        }
      }
    }
  }
}
