    "Ashling": {
      "email": "support@ashling.com",
      "role": "publisher"
    }
  },
  "demands": {
    "windows": {
      "install": {
        "unzip": "https://ashling-1.s3.eu-west-1.amazonaws.com/vcpkg-artifacts/arc-v-toolchain/arc-v-toolchain-win-x86_64-15.2.0.zip",
        "sha256": "72C34D67D056C23BF73F0B4653002CAE6039C1E5CF490954FCFF0A27B7F37EF8",
        "strip": 1
      },
      "exports": {
        "paths": {
          "PATH": "bin"
        },
        "tools": {
          "GCC_TOOLCHAIN_15_2_0": "./bin",
          "riscv64-snps-elf-gcc": "bin/riscv64-snps-elf-gcc.exe",
          "riscv64-snps-elf-gdb": "bin/riscv64-snps-elf-gdb.exe"
        }
      }
    },
    "linux": {
      "install": {
        "untar": "https://ashling-1.s3.eu-west-1.amazonaws.com/vcpkg-artifacts/arc-v-toolchain/arc-v-toolchain-linux-x86_64-15.2.0.tar.gz",
        "sha256": "9B657C2214AF7964BCCE93677ABFAC2CE8CA34A3236163A621E46D65D1534429",
        "strip": 1
      },
      "exports": {
        "paths": {
          "PATH": "bin"
        },
        "tools": {
          "GCC_TOOLCHAIN_15_2_0": "./bin",
          "riscv64-snps-elf-gcc": "bin/riscv64-snps-elf-gcc",
          "riscv64-snps-elf-gdb": "bin/riscv64-snps-elf-gdb"
        }
      }
    }
  }
}
