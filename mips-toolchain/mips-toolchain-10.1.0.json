{
  "id": "compilers/ashling/mips-toolchain",
  "version": "10.1.0",
  "summary": "MIPS GNU Tools for RISC-V",
  "description": "MIPS GNU Tools v1.10 for RISC-V (GCC 10.1.0 and GDB): riscv64-mti-elf for bare metal and riscv64-mti-linux-gnu for Linux, for MIPS RISC-V cores.",
  "contacts": {
    "Ashling": {
      "email": "support@ashling.com",
      "role": "publisher"
    }
  },
  "demands": {
    "windows": {
      "install": {
        "unzip": "https://ashling-1.s3.eu-west-1.amazonaws.com/vcpkg-artifacts/mips-toolchain/mips-toolchain-win-x86_64-10.1.0.zip",
        "sha256": "EEA97B8AE1B403BD5A6B4D104086CC7D3118C618AA558F930456734576F3EA59",
        "strip": 1
      },
      "exports": {
        "paths": {
          "PATH": [
            "riscv64-mti-elf/bin",
            "riscv64-mti-linux-gnu/bin"
          ]
        },
        "tools": {
          "GCC_TOOLCHAIN_10_1_0": "./riscv64-mti-elf/bin",
          "riscv64-mti-elf-gcc": "riscv64-mti-elf/bin/riscv64-mti-elf-gcc.exe",
          "riscv64-mti-elf-gdb": "riscv64-mti-elf/bin/riscv64-mti-elf-gdb.exe",
          "riscv64-mti-linux-gnu-gcc": "riscv64-mti-linux-gnu/bin/riscv64-mti-linux-gnu-gcc.exe",
          "riscv64-mti-linux-gnu-gdb": "riscv64-mti-linux-gnu/bin/riscv64-mti-linux-gnu-gdb.exe"
        }
      }
    }
  }
}
