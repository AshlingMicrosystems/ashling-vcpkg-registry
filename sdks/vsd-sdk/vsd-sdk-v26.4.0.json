    "Ashling": {
      "email": "support@ashling.com",
      "role": "publisher"
    }
  },
  "registries": [
    {
      "kind": "artifact",
      "name": "ashling",
      "location": "https://github.com/AshlingMicrosystems/ashling-vcpkg-registry/archive/refs/heads/main.zip"
    }
  ],
  "requires": {
    "ashling:compilers/ashling/riscv-toolchain": "12.1.0",
    "ashling:debuggers/ashling/gdbserver-riscv-vsd": "26.4.0",
    "ashling:tools/ashling/cli": "26.4.0",
    "ashling:tools/ashling/build-tools": "3.27.7",
    "ashling:examples/ashling/vsd-sdk-examples": "1.0.0",
    "ashling:drivers/ashling/opella-ld": "1.0.0",
    "ashling:rules/ashling/udev": "1.0.0"
  }
}
