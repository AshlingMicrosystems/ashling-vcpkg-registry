{
  "id": "compilers/ashling/riscv-toolchain",
  "version": "12.1.0",
  "summary": "GNU RISC-V toolchain for Ashling RiscFree",
  "description": "GCC-based riscv64-unknown-elf cross-compilation toolchain (gcc, gdb, binutils) bundled with the Ashling RiscFree SDK.",
  "contacts": {
    "Ashling": {
      "email": "support@ashling.com",
      "role": "publisher"
    }
  },
  "demands": {
    "windows": {
      "install": {
        "unzip": "https://ashling-1.s3.eu-west-1.amazonaws.com/vspkg-artifacts/risc-v-toolchain/riscv-toolchain-win-x86_64-12.1.zip",
        "sha256": "4FD10486085D28D31FB82FD5366F38DE5011030776235336E38AE6A915BE7AC4",
        "strip": 1
      },
      "exports": {
        "paths": {
          "PATH": "bin"
        },
        "tools": {
          "GCC_TOOLCHAIN_12_1_0": "./bin",
          "riscv64-unknown-elf-gcc": "bin/riscv64-unknown-elf-gcc.exe",
          "riscv64-unknown-elf-gdb": "bin/riscv64-unknown-elf-gdb.exe"
        }
      }
    }
  }
}
