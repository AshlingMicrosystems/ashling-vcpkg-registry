{
  "id": "debuggers/ashling/gdbserver-riscv-vsd",
  "version": "26.4.2",
  "summary": "Ashling RISC-V GDB Server for VSD",
  "description": "Ashling GDB server for debugging VSD RISC-V devices through Ashling debug probes.",
  "contacts": {
    "Ashling": {
      "email": "support@ashling.com",
      "role": "publisher"
    }
  },
  "demands": {
    "windows": {
      "install": {
        "unzip": "https://ashling-1.s3.eu-west-1.amazonaws.com/vcpkg-artifacts/vsd-risc-v-gdb-server/vsd-win-x86_64-26.4.2.zip",
        "sha256": "BA58AA854F13B8B127886BEC4315FC0CB3DA0B9E93A49D332729D0FF2C7DCF5F",
        "strip": 1
      },
      "exports": {
        "paths": {
          "PATH": ["gdbserver-riscv"],
          "DEVICE_DB": ["common/devices_db"],
          "GUI_OPXD_LIB": ["guiopxdif.dll"]
        },
        "tools": {
          "ash-riscv-gdb-server": "gdbserver-riscv/ash-riscv-gdb-server.exe",
		  "opxddiag" : "gdbserver-riscv/opxddiag.exe"
        }
      }
    }
  }
}
